FROM python:3.12-slim AS requirements

WORKDIR /tmp
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    curl
    # Add additional installations here with trailing `\` on each line \
RUN curl -LsSf https://astral.sh/uv/install.sh | less
# Cleanup the apt cache to reduce image size
RUN apt-get purge -y --auto-remove
RUN rm -rf /var/lib/apt/lists/*

RUN mkdir -p requirements
RUN pip install --upgrade pip
COPY ./pyproject.toml pyproject.toml
COPY ./uv.lock uv.lock
COPY scripts/uv_export_to_req_txt.sh uv_export_to_req_txt.sh
RUN chmod +x uv_export_to_req_txt.sh
RUN ./uv_export_to_req_txt.sh

# https://github.com/dask/dask-docker
FROM ghcr.io/dask/dask:2025.7.0-py3.12 as dask

USER root
# Mitigate the issue when running a flow with DaskTaskRunner
# RuntimeError: Unable to find any timezone configuration
# https://github.com/PrefectHQ/prefect/issues/3061
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && apt-get install -y tzdata
# Cleanup the apt cache
RUN apt-get purge -y --auto-remove
RUN rm -rf /var/lib/apt/lists/*
USER $NB_USER

COPY --from=requirements /tmp/requirements/requirements.txt requirements.txt
RUN pip install -r requirements.txt

# Add Avengercon code base
COPY ./README.md README.md
COPY ./pyproject.toml pyproject.toml
COPY ./avengercon avengercon
RUN pip install ./

ENV TZ="America/New_York"
#RUN cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

